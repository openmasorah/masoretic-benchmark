{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:masoretic:scorer_input.schema:v0.1.0",
  "title": "scorer_input.json",
  "description": "Input contract for masoretic-eval score --gt/--pred JSON files.",
  "type": "object",
  "required": ["text", "metamarks"],
  "additionalProperties": false,
  "properties": {
    "folio_id": {
      "type": "string",
      "minLength": 1
    },
    "gt_version": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "metamarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "verse_ref", "ordinal"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "Canonical tier-4 mark type. Defined once in masoretic_eval/tier4_vocabulary.py::TIER4_TYPES and asserted equal to this enum by tests/test_tier4_vocabulary_consistency.py. Retired spellings 'reversednun' (now 'inverted_nun') and 'puncta' (now 'puncta_extraordinaria') are rejected as of scorer 0.3.0.",
            "enum": [
              "pe",
              "samekh",
              "large_letter",
              "small_letter",
              "suspended_letter",
              "inverted_nun",
              "puncta_extraordinaria",
              "circellus",
              "rafe",
              "double_rafe"
            ]
          },
          "verse_ref": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "codepoints": {
            "type": "string"
          }
        }
      }
    }
  }
}

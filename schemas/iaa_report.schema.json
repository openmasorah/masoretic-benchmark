{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmesorah:iaa_report.schema:v0.1",
  "title": "iaa_report.json",
  "type": "object",
  "required": ["folios", "tier1", "tier2", "tier3", "tier4", "adjudication_summary"],
  "additionalProperties": true,
  "properties": {
    "folios": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 5},
    "tier1": {"$ref": "#/$defs/cer_tier"},
    "tier2": {"$ref": "#/$defs/cer_tier"},
    "tier3": {"$ref": "#/$defs/cer_tier"},
    "tier4": {"$ref": "#/$defs/f1_tier"},
    "adjudication_summary": {
      "type": "object",
      "required": ["tier1_disagreements_reconciled", "tier2_disagreements_reconciled", "tier3_disagreements_reconciled", "tier4_disagreements_reconciled"],
      "properties": {
        "tier1_disagreements_reconciled": {"type": "integer", "minimum": 0},
        "tier2_disagreements_reconciled": {"type": "integer", "minimum": 0},
        "tier3_disagreements_reconciled": {"type": "integer", "minimum": 0},
        "tier4_disagreements_reconciled": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "cer_tier": {
      "type": "object",
      "required": ["cer_vs_consensus_b", "ci95"],
      "properties": {
        "cer_vs_consensus_b": {
          "type": "number",
          "minimum": 0,
          "description": "Annotator B's round-0 transcription vs the adjudicated consensus reference, per DRAFT_v4 §5.2. NOT a bidirectional A-vs-B agreement figure and NOT an independent human-vs-reference baseline: the consensus is A's round-1 revision, byte-identical to B's round-2 endorsement, so it is not independent of either annotator. The paper reports no bidirectional tier-1/2/3 CER; the word does not appear in it. Renamed from bidirectional_cer_mean 2026-07-10 (B3)."
        },
        "ci95": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
      }
    },
    "f1_tier": {
      "type": "object",
      "required": ["f1_mean", "ci95"],
      "properties": {
        "f1_mean": {"type": "number", "minimum": 0, "maximum": 1},
        "ci95": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
      }
    }
  }
}
